# BedJet web app configuration
#
# Server-side only: these values are read by the Vite dev/preview server and are
# never exposed to the browser. Copy this file to `.env` and adjust as needed.

# Comma-separated list of hostnames the preview server will answer for.
#
# Required when the built app is reached through a hostname other than
# localhost — a reverse proxy or tunnel, for example. Without it the preview
# server rejects the request with:
#   Blocked request. This host ("...") is not allowed.
# ALLOWED_HOSTS=bedjet.example.com

# Shared bearer token for the hub API.
#
# Set this when the hub runs with HUB_API_TOKEN configured. The dev/preview
# proxy attaches it to outgoing `/api` and `/ws` requests server-side, so the
# browser never handles the secret and the web app needs no changes.
#
# Leave unset when the hub is unauthenticated, or when browser traffic is
# authenticated in front of the hub (Cloudflare Access, for example).
# HUB_API_TOKEN=
