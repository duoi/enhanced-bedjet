# BedJet Hub Configuration

# ---------------------------------------------------------
# Device Settings
# ---------------------------------------------------------
# BLE MAC address of the BedJet device.
# Leave empty to trigger auto-scan (if you only have one BedJet nearby).
# Example: BEDJET_ADDRESS=AA:BB:CC:DD:EE:FF
BEDJET_ADDRESS=

# ---------------------------------------------------------
# Hub API Settings
# ---------------------------------------------------------
# Network binding for the Hub REST API and WebSocket server
HUB_HOST=0.0.0.0
HUB_PORT=8265

# Path to the SQLite database (defaults to data/bedjet.db)
# DB_PATH=data/bedjet.db

# ---------------------------------------------------------
# Security Settings
# ---------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) protects your Hub from being
# controlled by malicious scripts running on other websites you visit.
# 
# For security, you MUST explicitly list the URLs you use to access the web UI.
# Include the exact protocol, IP, and port.
#
# Examples:
# - If you access the UI at http://192.168.1.50:8678:
#   CORS_ORIGINS=http://localhost:8678,http://localhost:5173,http://192.168.1.50:8678
# - If using a custom domain:
#   CORS_ORIGINS=http://localhost:8678,http://bedjet.local:8678
# 
# DANGER: Using "*" allows any website to control your BedJet.
# CORS_ORIGINS=*

CORS_ORIGINS=http://localhost:8678,http://localhost:5173

# ---------------------------------------------------------
# Authentication (optional)
# ---------------------------------------------------------
# The API is unauthenticated by default, which is only appropriate on a
# trusted network. Configure at least one mechanism below before exposing the
# hub to an untrusted network (for example, through a tunnel).
#
# The protected surface is /api/*, /ws, /docs, /redoc, and /openapi.json.
# When both mechanisms are configured, satisfying EITHER ONE is enough.

# --- 1. Shared bearer token -----------------------------------------------
# Clients must send: Authorization: Bearer <token>
# Generate one with: openssl rand -hex 32
# HUB_API_TOKEN=

# Browsers cannot set headers on a WebSocket handshake, so /ws also accepts
# the token as a ?token= query parameter. Set to false to disable that, at the
# cost of requiring a non-browser client (or Cloudflare Access) for live state.
# HUB_API_TOKEN_WS_QUERY=true

# --- 2. Cloudflare Access (or any JWT-issuing identity proxy) --------------
# Set the team domain and the Application Audience (AUD) tag of the Access
# application that fronts the hub. Every request must then carry a valid
# signed identity token, which is verified against the published signing keys.
# CF_ACCESS_TEAM_DOMAIN=https://<your-team>.cloudflareaccess.com
# CF_ACCESS_AUD=

# Optional: restrict access to specific identities (comma-separated).
# CF_ACCESS_ALLOWED_EMAILS=

# Optional: seconds to cache fetched signing keys before refetching.
# Access rotates its signing key every six weeks, so the default is safe.
# CF_ACCESS_JWKS_TTL=1800
