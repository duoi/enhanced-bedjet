# systemd unit template for the BedJet web API and scheduler.
#
# Install with ./install-systemd.sh: it substitutes the install-directory
# placeholder below with the path of your checkout. Do not copy this file into
# /etc/systemd/system by hand unless you substitute the placeholder yourself.
[Unit]
Description=BedJet Hub Server
Requires=bedjet-ble.service
After=network.target bluetooth.target bedjet-ble.service

[Service]
Type=simple
User=root
WorkingDirectory=__INSTALL_DIR__
Environment=PATH=__INSTALL_DIR__/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-__INSTALL_DIR__/.env
ExecStartPre=/bin/mkdir -p __INSTALL_DIR__/data
ExecStart=__INSTALL_DIR__/.venv/bin/python -m bedjet_hub
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
